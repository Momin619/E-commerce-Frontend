{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run start\" \"npm run tailwind\"",
    "start": "serve -s dist",
    "tailwind": "npx @tailwindcss/cli -i ./public/input.css -o ./src/output.css --watch",
    "build": "npm run tailwind:build && vite build",
    "tailwind:build": "npx @tailwindcss/cli -i ./public/input.css -o ./src/output.css"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.11",
    "axios": "^1.10.0",
    "concurrently": "^9.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.7.0",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "serve": "^14.2.4",
    "vite": "^7.0.4"
  }
}
